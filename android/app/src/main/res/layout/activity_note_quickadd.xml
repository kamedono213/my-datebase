<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickaddScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#55000000"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/quickaddCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_card_rounded"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/quickaddTitleInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="タイトル"
                    android:inputType="text"
                    android:maxLines="1"
                    android:background="@android:color/transparent"
                    android:textColorHint="#999999"
                    android:textColor="#1c1c1c"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E5E5"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/quickaddContentInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="4"
                    android:hint="内容"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:background="@android:color/transparent"
                    android:textColorHint="#999999"
                    android:textColor="#1c1c1c"
                    android:textSize="15sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/quickaddTagChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <EditText
                    android:id="@+id/quickaddTagsInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="タグ（カンマ区切り、上の候補をタップでも可）"
                    android:inputType="text"
                    android:maxLines="1"
                    android:background="@android:color/transparent"
                    android:textColorHint="#999999"
                    android:textColor="#1c1c1c"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical|end">

                    <TextView
                        android:id="@+id/quickaddCancelButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="閉じる"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:padding="10dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/quickaddSaveButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="保存"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:padding="10dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_bubble_circle"
                        android:minWidth="72dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/quickaddStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
