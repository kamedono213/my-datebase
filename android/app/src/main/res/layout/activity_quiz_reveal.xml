<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quizScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#55000000"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/quizCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_card_rounded"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/quizLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="このタイトルの内容は？"
                    android:textSize="12sp"
                    android:textColor="#888888" />

                <TextView
                    android:id="@+id/quizTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#1c1c1c" />

                <TextView
                    android:id="@+id/quizContentText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical|end">

                    <TextView
                        android:id="@+id/quizCloseButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="閉じる"
                        android:textColor="#666666"
                        android:textSize="14sp"
                        android:padding="10dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/quizRevealButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="答えを見る"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:padding="10dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_bubble_circle"
                        android:minWidth="88dp"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
